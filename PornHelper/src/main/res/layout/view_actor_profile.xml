<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainLayout"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/avatarImageView"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:contentDescription="@string/image_describe" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="@dimen/value_10dp">

            <!-- 名字 + 箭头 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/nameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_16sp"
                    android:textColor="@color/black"
                    android:text="@string/actor_name" />

                <Space
                    android:layout_width="20dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/arrowImageView"
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:scaleType="fitXY"
                    android:adjustViewBounds="true"
                    android:src="@drawable/ic_arrow_down"
                    android:contentDescription="@string/image_describe" />
            </LinearLayout>

            <!-- info 区域：动态添加，内容多高就多高 -->
            <LinearLayout
                android:id="@+id/infoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/value_3dp" />

            <!--
                按钮区：
                - 占剩余高度（layout_weight=1）
                - 自身内容纵向居中（gravity=center_vertical）
                - 最少 40dp，避免 info 很多时按钮被压没
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/value_3dp">

                <com.varunest.sparkbutton.SparkButton
                    android:id="@+id/sparkButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:sparkbutton_activeImage="@drawable/ic_star_fill"
                    app:sparkbutton_animationSpeed="0.8"
                    app:sparkbutton_iconSize="25dp"
                    app:sparkbutton_inActiveImage="@drawable/ic_star"
                    app:sparkbutton_primaryColor="@color/favorite"
                    app:sparkbutton_secondaryColor="@color/secondaryColor" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/favoriteMaterialButton"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/favorite_text"
                    android:textColor="@color/favorite"
                    android:textSize="@dimen/text_14sp"
                    app:cornerRadius="@dimen/value_10dp"
                    app:strokeColor="@color/favorite"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 简介区 -->
    <LinearLayout
        android:id="@+id/biographyLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_5dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/biographyView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:textSize="@dimen/text_13sp"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>