<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/value_10dp"
    android:layout_marginStart="@dimen/value_5dp"
    android:layout_marginEnd="@dimen/value_5dp"
    app:cardPreventCornerOverlap="true"
    app:cardCornerRadius="@dimen/value_0dp"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/value_5dp"
        android:layout_marginBottom="@dimen/value_5dp"
        android:layout_marginStart="@dimen/value_5dp"
        android:layout_marginEnd="@dimen/value_5dp"
        android:orientation="vertical">

        <!-- 头像区（无头像时 GONE） -->
        <ImageView
            android:id="@+id/avatarView"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scaleType="centerCrop"
            android:visibility="gone"
            tools:visibility="visible"
            android:contentDescription="@string/image_describe"/>

        <!-- 名字（头像下方，水平居中） -->
        <TextView
            android:id="@+id/nameView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/value_5dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textStyle="bold"
            android:textSize="@dimen/text_18sp"
            android:textColor="@color/black_10"
            tools:text="@string/actor_name"/>

        <!-- 信息区 -->
        <LinearLayout
            android:id="@+id/infoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/value_5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- 收藏图标（有收藏才显示） -->
            <ImageView
                android:id="@+id/favoriteView"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="@dimen/value_6dp"
                android:visibility="gone"
                android:contentDescription="@string/image_describe"
                android:src="@drawable/ic_star_fill"
                android:layout_gravity="center"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>