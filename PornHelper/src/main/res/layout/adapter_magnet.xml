<?xml version="1.0" encoding="utf-8"?>
<!--防止cardview内部内容与边角重叠 app:cardPreventCornerOverlap="true"-->
<!--阴影  app:cardElevation="10dp"-->
<!--背景颜色 app:cardBackgroundColor="@color/colorAccent"-->
<!--圆角 app:cardCornerRadius="10dp"-->
<!--内容内边距 app:contentPadding="4dp"-->
<!--开启点击效果 android:clickable="true"-->
<!--设置水波纹点击效果 android:foreground="?android:attr/selectableItemBackground"-->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardPreventCornerOverlap="true"
    app:cardCornerRadius="@dimen/value_0dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- 外层横向：左文本块 + 右药丸 -->
    <LinearLayout
        android:id="@+id/itemRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="@dimen/value_12dp">

        <!-- 左边：两行文本 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/magnet_title"
                android:textColor="@color/black_60"
                android:textSize="@dimen/text_14sp"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/infoView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/value_5dp"
                android:textSize="@dimen/text_10sp"
                android:textColor="@color/black_60"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 右边：药丸，垂直居中 -->
        <TextView
            android:id="@+id/magnetTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/value_12dp"
            android:background="@drawable/bg_pill_outline"
            android:paddingStart="@dimen/value_15dp"
            android:paddingEnd="@dimen/value_15dp"
            android:paddingTop="@dimen/value_4dp"
            android:paddingBottom="@dimen/value_4dp"
            android:text="@string/magnet_text"
            android:textSize="@dimen/text_14sp"
            android:textColor="@color/black_60"
            android:maxLines="1"
            android:ellipsize="middle" />

    </LinearLayout>
</androidx.cardview.widget.CardView>